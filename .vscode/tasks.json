{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet restore",
      "type": "process",
      "command": "dotnet",
      "args": ["restore", "SentenceStock.slnx"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "SentenceStock.slnx", "--no-restore"],
      "dependsOn": "dotnet restore",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "SentenceStock.slnx", "--no-build"],
      "dependsOn": "dotnet build",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "frontend install",
      "type": "process",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend build",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "dependsOn": "frontend install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "run api",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "src/SentenceStock.Api/SentenceStock.Api.csproj"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run frontend",
      "type": "process",
      "command": "npm",
      "args": ["run", "serve"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
